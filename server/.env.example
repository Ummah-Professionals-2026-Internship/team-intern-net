# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=team_intern_net
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password_here

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# ─── Google OAuth / Calendar ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# ─── Email (SMTP via Gmail) ───────────────────────────────────────────────────
# Create a Gmail App Password: https://myaccount.google.com/apppasswords
# Leave blank to disable email features during local development
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_gmail_address@gmail.com

# ─── Frontend URL (used in password reset email links) ───────────────────────
# Local dev default: http://localhost:5173
# Production: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173
